# ---- Copy this file to .env and fill in the values (never commit .env) ----

# API server
NODE_ENV=development
PORT=4000
# Origin allowed by CORS (the Vite dev server). Comma-separate for several.
CLIENT_ORIGIN=http://localhost:5173

# MySQL 8 connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gym
DB_PASSWORD=change_me_db_password
DB_NAME=gym_classes
# Separate database used only by `npm test` (created automatically)
DB_TEST_NAME=gym_classes_test
# Only used by docker-compose.yml to initialise the MySQL container
MYSQL_ROOT_PASSWORD=change_me_root_password

# Auth: use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Business rules
# IANA timezone used to decide "today" for membership dates
GYM_TIMEZONE=Asia/Kolkata
# Members can book / cancel until this many minutes before class start
BOOKING_CUTOFF_MINUTES=120
# Send membership-expiry reminders this many days before the end date
REMINDER_DAYS_BEFORE=7
# Set to false to disable the daily reminder cron job
ENABLE_CRON=true
